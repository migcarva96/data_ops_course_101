# ---------------------------------------------------------------------------
# Plantilla de variables de entorno — Sesión 4 (Ingesta hacia Snowflake)
#
# Uso:
#   cp .env.example .env
#   Completa cada valor con datos reales. Nunca se versiona (ver .gitignore raíz).
# ---------------------------------------------------------------------------

# Neon — la MISMA branch dev de las Sesiones 1-3. Nunca la de main.
NEON_DEV_DATABASE_URL=postgresql://usuario:password@ep-xxxx-dev.us-east-2.aws.neon.tech/neondb?sslmode=require

# Snowflake — de dónde sale cada valor:
#   SNOWFLAKE_ACCOUNT   Snowsight -> ícono de perfil (abajo a la izquierda) -> "Account"
#                       -> copia el "Account identifier". Formato típico:
#                       <organización>-<cuenta>, ej. ABCDEFG-XY12345
#   SNOWFLAKE_USER      El usuario con el que inicias sesión en Snowsight.
#   SNOWFLAKE_PASSWORD  Su contraseña.
#   El resto son los nombres creados por setup_snowflake.sql — no los cambies salvo
#   que también hayas editado ese script.
SNOWFLAKE_ACCOUNT=tu_identificador_de_cuenta
SNOWFLAKE_USER=tu_usuario
SNOWFLAKE_PASSWORD=tu_password
SNOWFLAKE_WAREHOUSE=WH_DATAOPS
SNOWFLAKE_DATABASE=PARCH_AND_POSEY
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=DATAOPS_LOADER
